{
  "extends": "@zsyio/config-typescript/tsconfig.next.json",
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@zsyio/database": [
        "../../packages/database/src"
      ],
      "@zsyio/types": [
        "../../packages/types/src"
      ],
      "@zsyio/validators": [
        "../../packages/validators/src"
      ],
      "@zsyio/auth": [
        "../../packages/auth/src"
      ],
      "@zsyio/ui": [
        "../../packages/ui/src"
      ],
      "@zsyio/editor": [
        "../../packages/editor/src"
      ],
      "@plugins/*": [
        "../../plugins/*"
      ],
      "@tokens/*": [
        "../../tokens/*"
      ]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "../../packages/auth/src/next-auth.d.ts",
    ".next/landing-preview/types/**/*.ts",
    ".next/types/**/*.ts",
    "next-env.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
