{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./apps/pms/src/*"
      ],
      "@zsyio/database": [
        "./packages/database/src"
      ],
      "@zsyio/types": [
        "./packages/types/src"
      ],
      "@zsyio/validators": [
        "./packages/validators/src"
      ],
      "@zsyio/auth": [
        "./packages/auth/src"
      ],
      "@zsyio/ui": [
        "./packages/ui/src"
      ],
      "@zsyio/ui/*": [
        "./packages/ui/src/*"
      ],
      "@zsyio/editor": [
        "./packages/editor/src"
      ],
      "@plugins/*": [
        "./plugins/*"
      ],
      "@tokens/*": [
        "./tokens/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts",
    "**/*.mts"
  ],
  "exclude": [
    "node_modules",
    "apps/sales",
    "apps/hrms",
    "apps/notes",
    "apps/admin"
  ]
}
