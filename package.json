{
  "name": "zsyio-one-monorepo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "turbo run dev",
    "dev:parallel": "turbo run dev --parallel",
    "dev:pms": "turbo run dev --filter=@zsyio/pms",
    "dev:notes": "turbo run dev --filter=@zsyio/notes",
    "dev:hrms": "turbo run dev --filter=@zsyio/hrms",
    "dev:admin": "turbo run dev --filter=@zsyio/admin",
    "dev:sales": "turbo run dev --filter=@zsyio/sales",
    "build": "turbo run build",
    "start": "turbo run start",
    "start:pms": "turbo run start --filter=@zsyio/pms",
    "start:notes": "turbo run start --filter=@zsyio/notes",
    "start:hrms": "turbo run start --filter=@zsyio/hrms",
    "start:admin": "turbo run start --filter=@zsyio/admin",
    "start:sales": "turbo run start --filter=@zsyio/sales",
    "predev": "node scripts/setup-env.mjs",
    "prebuild": "node scripts/setup-env.mjs",
    "env:setup": "node scripts/setup-env.mjs",
    "build:tokens": "node scripts/build-tokens.mjs",
    "check:colors": "node scripts/check-no-raw-colors.mjs",
    "postinstall": "node scripts/setup-env.mjs && turbo run db:generate",
    "lint": "turbo run lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:ui": "vitest --ui",
    "type-check": "turbo run type-check",
    "db:generate": "turbo run db:generate",
    "db:migrate": "turbo run db:migrate",
    "db:push": "pnpm --filter @zsyio/database db:push",
    "db:seed": "turbo run db:seed",
    "db:seed:recruit": "tsx --env-file=.env.local scripts/seed-recruit.ts",
    "db:reset-passwords": "npx dotenv-cli -e .env.local -- tsx scripts/reset-passwords.ts",
    "db:studio": "turbo run db:studio",
    "clean": "node scripts/clean.mjs",
    "dev:recruit": "turbo run dev --filter=@zsyio/recruit",
    "start:recruit": "turbo run start --filter=@zsyio/recruit",
    "deploy:check": "node scripts/check-deployment.mjs"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@google/genai": "^2.24.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/ui": "^4.1.10",
    "@zsyio/config-eslint": "workspace:*",
    "eslint": "^9",
    "eslint-config-next": "15.5.23",
    "prisma": "^6.19.3",
    "puppeteer-core": "^25.12.0",
    "tsx": "^4.23.12",
    "turbo": "^2.4.4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@zsyio/auth": "workspace:*",
    "@zsyio/database": "workspace:*",
    "@zsyio/editor": "workspace:*",
    "@zsyio/types": "workspace:*",
    "@zsyio/ui": "workspace:*",
    "@zsyio/validators": "workspace:*"
  }
}
