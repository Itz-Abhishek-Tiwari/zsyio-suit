# ==============================================================================
# Zsyio Suite - Monorepo Environment Configuration Template (.env.example)
# Duplicate this file to .env or .env.local and fill in your values.
# ==============================================================================

# ── Database Connection (Supabase / PostgreSQL Pooler) ───────────────────────
# Transaction Pooler (Port 6543) - used by Next.js apps for high-concurrency queries (connection_limit=5: Fluid Compute shares one instance across concurrent requests)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=5&pool_timeout=20&connect_timeout=15"

# Direct / Session Pooler (Port 5432) - used by Prisma for migrations and schema push
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[YOUR-PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres?connect_timeout=15"

# ── Supabase Realtime (WebSockets for live updates without polling) ───────────
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"

# ── Authentication Configuration (NextAuth v5) ────────────────────────────────
# Generate with: openssl rand -base64 32
# Omit AUTH_URL in local dev so Auth.js dynamically infers each app's port (3000, 3001, 3002)
# AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="1"
# Shared Single Sign-On Cookie Domain (Production: ".zsyio.de", Local dev: leave empty)
# COOKIE_DOMAIN=".zsyio.de"

# ── Application URLs ─────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_PMS_URL="http://localhost:3000"
NEXT_PUBLIC_NOTES_URL="http://localhost:3001"
NEXT_PUBLIC_HRMS_URL="http://localhost:3002"
NEXT_PUBLIC_ADMIN_URL="http://localhost:3003"
NEXT_PUBLIC_SALES_URL="http://localhost:3005"

# ── Application Configuration ─────────────────────────────────────────────────
ACTIVE_BRAND="zsyio-default"
CRON_SECRET="your-secure-cron-secret"
EMAIL_FROM="notifications@zsyio.com"
EMAIL_FROM_NAME="Zsyio"
APP_TIMEZONE="Europe/Berlin"
NEXT_PUBLIC_APP_TIMEZONE="Europe/Berlin"

# ── Workspace Access Domain Restriction ────────────────────────────────────────
# Comma-separated list of approved email domains allowed to access/join the workspace.
ALLOWED_EMAIL_DOMAINS="zsyio.com"
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS="zsyio.com"

# ── Super Admin / Workspace Owner Configuration ───────────────────────────────
# Primary super administrator email(s) that are permanently protected from deletion/role modification.
SUPER_ADMIN_EMAIL="alex.vance@zsyio.com"
NEXT_PUBLIC_SUPER_ADMIN_EMAIL="alex.vance@zsyio.com"

# ── Zoho ZeptoMail Email Provider ──────────────────────────────────────────────
# Set Send Mail Token generated from ZeptoMail Agent Setup / SMTP / API tab:
ZEPTOMAIL_TOKEN="Zoho-enczapikey wSsVR6xxxxxxx..."
# EU Datacenter: https://api.zeptomail.eu/ | US/Global: https://api.zeptomail.com/ | India: https://api.zeptomail.in/
ZEPTOMAIL_URL="https://api.zeptomail.eu/"
ZEPTOMAIL_FROM_EMAIL="notifications@zsyio.com"
ZEPTOMAIL_FROM_NAME="Zsyio"

# Alternative email provider key (e.g. Resend, optional)
EMAIL_PROVIDER_API_KEY=""

# ── Storage Providers (Optional / S3 / Cloudflare R2 / Supabase Storage) ──────
STORAGE_PROVIDER_URL=""
STORAGE_PROVIDER_ACCESS_KEY=""
STORAGE_PROVIDER_SECRET_KEY=""
STORAGE_BUCKET_NAME=""

# ── Microsoft Teams Integration (Webhook / Workflow URL) ────────────────────
# Generate via MS Teams Channel -> Workflows -> "Post to a channel when a webhook request is received"
TEAMS_WEBHOOK_URL="https://prod-xx.westus.logic.azure.com/workflows/..."

# ── AI Integration (Google Gemini 2.5 Flash Git Branch & QA Generator) ─────────
# Gemini API Key used to generate concise 2-4 word git branch slugs and QA test cases
GEMINI_API_KEY=""
# Optional model override (defaults to gemini-2.5-flash)
GEMINI_MODEL="gemini-2.5-flash"

# Recruit application
NEXT_PUBLIC_RECRUIT_URL="http://localhost:3006"

# Public marketing site and careers page
NEXT_PUBLIC_LANDING_URL="http://localhost:3007"
